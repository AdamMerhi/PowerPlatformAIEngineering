# Copy to .env (git-ignored). In cloud sessions, set these as environment variables instead.

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=POC_SVC
SNOWFLAKE_ROLE=POC_ROLE
SNOWFLAKE_WAREHOUSE=CLAIMS_WH
SNOWFLAKE_DATABASE=CLAIMS_POC
SNOWFLAKE_PRIVATE_KEY_PATH=
# or, if not using key-pair auth:
SNOWFLAKE_PASSWORD=
# Schema used by dbt's dev target and claims_pipeline.load (RAW for the motor-claims ingest)
SNOWFLAKE_SCHEMA=RAW

# dbt (DAG C: motor claims)
# DBT_PROFILES_DIR=dbt

# Azure / Dataverse (later)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
DATAVERSE_URL=
